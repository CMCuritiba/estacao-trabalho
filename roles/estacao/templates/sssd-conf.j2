# SSSD CMC
#
# ATENÇÃO: este arquivo não permite comentários inline

# Vide:
# https://manpages.ubuntu.com/manpages/noble/man5/sssd.conf.5.html
# https://manpages.ubuntu.com/manpages/noble/man5/sssd-ad.5.html
# https://manpages.ubuntu.com/manpages/noble/man5/sssd-ldap.5.html
# https://manpages.ubuntu.com/manpages/noble/man5/sssd-krb5.5.html

[sssd]
domains = {{ estacao_ad_domain | lower }}
config_file_version = 2
services = nss, pam

[domain/{{ estacao_ad_domain | lower }}]
# Providers
id_provider = ad
# auth_provider = ad
# chpass_provider = ad
access_provider = ad
# ldap_schema = ad

# Domain & Realm
ad_domain = {{ estacao_ad_domain | lower }}
krb5_realm = {{ estacao_ad_domain | upper }}

# Autodiscovery Disabled: Explicit DC endpoints and disabled site lookups
# ad_enable_dns_sites = false
# ad_server = {{ estacao_ad_kdc | join(', ') }}
# krb5_server = {{ estacao_ad_kdc | join(', ') }}

# Workstation Identity & Access Defaults
cache_credentials = True
realmd_tags = manages-system joined-with-samba
ldap_id_mapping = False
ldap_user_name = uid
use_fully_qualified_names = False
fallback_homedir = /home/%u
default_shell = /bin/bash
dyndns_update = False

krb5_store_password_if_offline = True
ad_access_filter = (&(employeeNumber=*)(objectClass=inetOrgPerson))
ad_gpo_access_control = disabled

# DNS & LDAP Timeouts
dns_resolver_op_timeout = 5
# dns_resolver_timeout deve ser maior que dns_resolver_op_timeout
dns_resolver_timeout = 10
# ldap_opt_timeout deve ser maior que dns_resolver_timeout
ldap_opt_timeout = 15
ldap_network_timeout = 20
dns_discovery_domain = {{ estacao_ad_domain | lower }}
